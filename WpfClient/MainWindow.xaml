<Window x:Class="WpfClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfClient"
        mc:Ignorable="d"
        Title="Sajam knjiga"
        WindowStartupLocation="Manual"
        Loaded="Window_Loaded" d:DesignWidth="435" d:DesignHeight="140">

    <DockPanel>


        <!-- TOOLBAR SA IKONICAMA -->
        <Border DockPanel.Dock="Top"
        Background="#F0F0F0"
        Padding="6"
        BorderBrush="#CCCCCC"
        BorderThickness="0,0,0,1">

            <StackPanel Orientation="Horizontal">

                <!-- 1. DODAJ -->
                <Button x:Name="BtnAdd"
                Click="BtnAdd_Click"
                ToolTip="Dodaj novi entitet (Ctrl+A)"
                Margin="0,0,8,0"
                Padding="8,4" Width="34">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Icons/add-user.png" Width="16" Height="16" Margin="0,0,4,0"/>
                    </StackPanel>
                </Button>

                <!-- 2. IZMENI -->
                <Button x:Name="BtnEdit"
                Click="BtnEdit_Click"
                ToolTip="Izmeni selektovani entitet (Ctrl+E)"
                Margin="0,0,8,0"
                Padding="8,4" Width="33">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Icons/edit-user.png" Width="16" Height="16" Margin="0,0,4,0"/>
                    </StackPanel>
                </Button>

                <!-- 3. OBRISI -->
                <Button x:Name="BtnDelete"
                Click="BtnDelete_Click"
                ToolTip="Obriši selektovani entitet (Del)"
                Margin="0,0,24,0"
                Padding="8,4" Width="33">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Icons/delete-user.png" Width="16" Height="16" Margin="0,0,4,0"/>
                    </StackPanel>
                </Button>


                <!-- 4. PRETRAGA -->
                <StackPanel Orientation="Horizontal" Margin="150,0,0,0">
                    <TextBox x:Name="TxtSearch"
                     Width="102"
                     Padding="6"
                     KeyDown="TxtSearch_KeyDown"
                     ToolTip="Unesite tekst za pretragu (Ctrl+F)" Height="13" RenderTransformOrigin="-1.196,0.38">
                        <TextBox.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="-1"/>
                                <SkewTransform/>
                                <RotateTransform/>
                                <TranslateTransform X="345.984"/>
                            </TransformGroup>
                        </TextBox.RenderTransform>
                    </TextBox>
                </StackPanel>
                <Button x:Name="BtnSearch"
                    Background="#FFF0F0F0"
                     Foreground="White"
                    BorderThickness="1"
                     BorderBrush="Transparent"
                    Click="BtnSearch_Click"
                    ToolTip="Pretraži (Enter)"
                    Padding="8,4" Height="28" Width="35">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Icons/magnifier.png" Width="16" Height="16" Margin="0,0,4,0"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </Border>


        <!-- TABOVI-->
        <TabControl x:Name="MainTabs"
            SelectionChanged="MainTabs_SelectionChanged"
            Margin="10"
            Background="White"
            BorderBrush="#E0E0E0"
            BorderThickness="1" Height="105">

            <!-- Tab 1: Knjige -->
            <TabItem Header="Knjige">
                <DataGrid x:Name="BooksGrid"
                  ItemsSource="{Binding Books}"
                  SelectedItem="{Binding SelectedBook, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Margin="10"
                  BorderBrush="#E0E0E0"
                  BorderThickness="1"
                  RowBackground="White"
                  AlternatingRowBackground="#F8F9FA">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ISBN" 
                                    Binding="{Binding ISBN}" 
                                    Width="120"/>
                        <DataGridTextColumn Header="Naziv" 
                                    Binding="{Binding Title}" 
                                    Width="2*"/>
                        <DataGridTextColumn Header="Cena" 
                                    Binding="{Binding Price, StringFormat='{}{0:C}'}" 
                                    Width="100"/>
                        <DataGridTextColumn Header="Godina" 
                                    Binding="{Binding ReleaseYear}" 
                                    Width="80"/>
                        <DataGridTextColumn Header="Žanr" 
                                    Binding="{Binding Genre}" 
                                    Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Tab 2: Posetioci -->
            <TabItem Header="Posetioci">
                <DataGrid x:Name="VisitorsGrid"
              ItemsSource="{Binding Visitors}"
              SelectedItem="{Binding SelectedVisitor, Mode=TwoWay}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              Margin="10"
              BorderBrush="#E0E0E0"
              BorderThickness="1"
              RowBackground="White"
              AlternatingRowBackground="#F8F9FA"
              FontSize="12"
              HeadersVisibility="Column">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Broj članske karte" 
                                Binding="{Binding MembershipNumber}" 
                                Width="130"/>
                        <DataGridTextColumn Header="Ime" 
                                Binding="{Binding Name}" 
                                Width="80"/>
                        <DataGridTextColumn Header="Prezime" 
                                Binding="{Binding LastName}" 
                                Width="90"/>
                        <DataGridTextColumn Header="Adresa" 
                            Binding="{Binding Address.DisplayAddress}" 
                            Width="200"/>
                        <DataGridTextColumn Header="Status" 
                                Binding="{Binding DisplayStatus}" 
                                Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Tab 3: Autori -->
            <TabItem Header="Autori">
                <DataGrid x:Name="AuthorsGrid"
                  ItemsSource="{Binding Authors}"
                  SelectedItem="{Binding SelectedAuthor, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Margin="10"
                  BorderBrush="#E0E0E0"
                  BorderThickness="1"
                  RowBackground="White"
                  AlternatingRowBackground="#F8F9FA">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ime" 
                                    Binding="{Binding FirstName}" 
                                    Width="*"/>
                        <DataGridTextColumn Header="Prezime" 
                                    Binding="{Binding LastName}" 
                                    Width="*"/>
                        <DataGridTextColumn Header="Lična karta" 
                                    Binding="{Binding IdCardNumber}" 
                                    Width="120"/>
                        <DataGridTextColumn Header="Datum rođenja" 
                                    Binding="{Binding DateOfBirth, StringFormat='dd.MM.yyyy.'}" 
                                    Width="120"/>
                        <DataGridTextColumn Header="Email" 
                                    Binding="{Binding Email}" 
                                    Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

        </TabControl>

    </DockPanel>
</Window>
