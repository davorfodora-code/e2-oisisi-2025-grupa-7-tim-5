<Window x:Class="WpfClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfClient"
        mc:Ignorable="d"
        Title="Sajam knjiga"
        Height="700" Width="1000"
        WindowStartupLocation="CenterScreen">
<Grid>
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="#F0F0F0">
            <MenuItem Header="File">
                <MenuItem Header="New" Click="FileNew_Click">
                    <MenuItem.Icon>
                        <Image Source="/Icons/plus.png" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Save" Click="FileSave_Click">
                    <MenuItem.Icon>
                        <Image Source="/Icons/diskette.png" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Open">
                    <MenuItem.Icon>
                        <Image Source="/Icons/share.png" Width="16" Height="16"/>
                    </MenuItem.Icon>
                    <MenuItem Header="Posetioci" Click="OpenPosetioci_Click">
                        <MenuItem.Icon>
                            <Image Source="/Icons/multiple-users-silhouette.png" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Knjige" Click="OpenKnjige_Click">
                        <MenuItem.Icon>
                            <Image Source="/Icons/open-book.png" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Autori" Click="OpenAutori_Click">
                        <MenuItem.Icon>
                            <Image Source="/Icons/author.png" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Izdavači" Click="OpenIzdavaci_Click">
                        <MenuItem.Icon>
                            <Image Source="/Icons/publisher.png" Width="16" Height="16"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="Edit">
                <MenuItem Header="Edit" Click="EditEdit_Click">
                    <MenuItem.Icon>
                        <Image Source="/Icons/edit-user.png" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Delete" Click="EditDelete_Click">
                    <MenuItem.Icon>
                        <Image Source="/Icons/delete-user.png" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="Help">
                <MenuItem Header="About" Click="HelpAbout_Click">
                    <MenuItem.Icon>
                        <Image Source="/Icons/information-button.png" Width="16" Height="16"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom" Background="#F0F0F0">
            <StatusBarItem>
                <TextBlock x:Name="StatusBarDate" Text="Datum: " Width="120"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="StatusBarTime" Text="Vreme: " Width="100"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="StatusBarAppName" Text="Sajam knjiga" Width="100"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="StatusBarTabName" Text="Tab: " Width="200"/>
            </StatusBarItem>

           
  
        </StatusBar>

        <Border DockPanel.Dock="Top"
                Background="#F0F0F0"
                Padding="6"
                BorderBrush="#CCCCCC"
                BorderThickness="0,0,0,1">
            <Grid HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
               

                <StackPanel Orientation="Horizontal" Grid.Column="0">
                    <Button x:Name="BtnAdd"
                            Click="BtnAdd_Click"
                            Margin="0,0,8,0"
                            Padding="8,4"
                            Width="34">
                        <Image Source="pack://application:,,,/Icons/add-user.png"
                               Width="16" Height="16"/>
                    </Button>

                    <Button x:Name="BtnEdit"
                            Click="BtnEdit_Click"
                            Margin="0,0,8,0"
                            Padding="8,4"
                            Width="33">
                        <Image Source="/Icons/edit-user.png"
                               Width="16" Height="16"/>
                    </Button>

                    <Button x:Name="BtnDelete"
                            Click="BtnDelete_Click"
                            Margin="0,0,24,0"
                            Padding="8,4"
                            Width="33">
                        <Image Source="/Icons/delete-user.png"
                               Width="16" Height="16"/>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <TextBox x:Name="TxtSearch"
                             Width="200"
                             Height="28"
                             Padding="6"
                             KeyDown="TxtSearch_KeyDown"
                             TextChanged="TxtSearch_TextChanged"/>

                    <Button x:Name="BtnSearch"
                            Width="35"
                            Height="28"
                            Margin="5,0,0,0"
                            Click="BtnSearch_Click">
                        <Image Source="/Icons/magnifier.png"
                               Width="16"
                               Height="16"/>
                    </Button>
                </StackPanel>
                  <StackPanel x:Name="ToastContainer" 
                    VerticalAlignment="Bottom"     
                    HorizontalAlignment="Right"     
                    Margin="10"                     
                    Panel.ZIndex="9999">
                    </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs"
                    SelectionChanged="MainTabs_SelectionChanged"
                    Margin="10"
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1">


            <!-- ===== TAB KNJIGE ===== -->
            <TabItem Header="Knjige">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal"
                                HorizontalAlignment="Left" Margin="0,0,0,10">
                        <Button x:Name="BtnCompareBooks"
                                Content="Poredi knjige"
                                Width="120"
                                Height="30"
                                Click="BtnCompareBooks_Click"/>
                        
                    </StackPanel>
                  
                

                    <DataGrid Grid.Row="1"
                              x:Name="BooksGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              BorderBrush="#E0E0E0"
                              BorderThickness="1"
                              RowBackground="White"
                              AlternatingRowBackground="#F8F9FA"
                              FontSize="14"
                              RowHeight="30"
                              HeadersVisibility="Column"
                              VerticalGridLinesBrush="#E0E0E0"
                              HorizontalGridLinesBrush="#E0E0E0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ISBN"
                                               Binding="{Binding Isbn}"
                                               Width="120"/>
                            <DataGridTextColumn Header="Naziv"
                                               Binding="{Binding Name}"
                                               Width="2*"/>
                            <DataGridTextColumn Header="Cena"
                                               Binding="{Binding Price, StringFormat='{}{0:C}'}"
                                               Width="100"/>
                            <DataGridTextColumn Header="Godina"
                                               Binding="{Binding PublicationYear}"
                                               Width="80"/>
                            <DataGridTextColumn Header="Žanr"
                                               Binding="{Binding Genre}"
                                               Width="*"/>
                        </DataGrid.Columns>

                    </DataGrid>
                  
                 
                </Grid>
                     
            </TabItem>
                   

            <!-- ===== TAB POSETIOCI ===== -->
            <TabItem Header="Posetioci">
                <DataGrid x:Name="VisitorsGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Margin="10"
                          BorderBrush="#E0E0E0"
                          BorderThickness="1"
                          RowBackground="White"
                          AlternatingRowBackground="#F8F9FA"
                          FontSize="14"
                          RowHeight="30"
                          HeadersVisibility="Column"
                          VerticalGridLinesBrush="#E0E0E0"
                          HorizontalGridLinesBrush="#E0E0E0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Broj članske karte"
                                           Binding="{Binding MembershipNumber}"
                                           Width="150"/>
                        <DataGridTextColumn Header="Ime"
                                           Binding="{Binding Name}"
                                           Width="100"/>
                        <DataGridTextColumn Header="Prezime"
                                           Binding="{Binding LastName}"
                                           Width="120"/>
                        <DataGridTextColumn Header="Adresa"
                                           Binding="{Binding DisplayAddress}"
                                           Width="250"/>
                        <DataGridTextColumn Header="Status"
                                           Binding="{Binding DisplayStatus}"
                                           Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>

            </TabItem>

            <!-- ===== TAB AUTORI ===== -->
            <TabItem Header="Autori">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal"
                                HorizontalAlignment="Left" Margin="0,0,0,10">
                        <Button x:Name="BtnShowVisitorsByAuthor"
                                Content="Autor-Posetioci"
                                Width="120"
                                Height="30"
                                Click="BtnShowVisitorsByAuthor_Click"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              x:Name="AuthorsGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              BorderBrush="#E0E0E0"
                              BorderThickness="1"
                              RowBackground="White"
                              AlternatingRowBackground="#F8F9FA"
                              FontSize="14"
                              RowHeight="30"
                              HeadersVisibility="Column"
                              VerticalGridLinesBrush="#E0E0E0"
                              HorizontalGridLinesBrush="#E0E0E0"
                              SelectionChanged="AuthorsGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ime"
                                               Binding="{Binding Name}"
                                               Width="*"/>
                            <DataGridTextColumn Header="Prezime"
                                               Binding="{Binding Lastname}"
                                               Width="*"/>
                            <DataGridTextColumn Header="Lična karta"
                                               Binding="{Binding IdCard}"
                                               Width="120"/>
                            <DataGridTextColumn Header="Datum rođenja"
                                               Binding="{Binding DateOfBirth, StringFormat='dd.MM.yyyy.'}"
                                               Width="120"/>
                            <DataGridTextColumn Header="Email"
                                               Binding="{Binding Email}"
                                               Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ===== TAB IZDAVACI ===== -->
            <TabItem Header="Izdavači">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal"
                                HorizontalAlignment="Left" Margin="0,0,0,10">
                        <Button x:Name="BtnSetPublisherManager"
                                Content="Postavi šefa izdavača"
                                Width="150"
                                Height="30"
                                Click="BtnSetPublisherManager_Click"/>

                        <Button x:Name="BtnShowPublisherBooks"
                                Content="Izdavač-Knjige"
                                Width="120"
                                Height="30"
                                Margin="10,0,0,0"
                                Click="BtnShowPublisherBooks_Click"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              x:Name="PublishersGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              BorderBrush="#E0E0E0"
                              BorderThickness="1"
                              RowBackground="White"
                              AlternatingRowBackground="#F8F9FA"
                              FontSize="14"
                              RowHeight="30"
                              HeadersVisibility="Column"
                              VerticalGridLinesBrush="#E0E0E0"
                              HorizontalGridLinesBrush="#E0E0E0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Naziv izdavača" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="Menadžer" Binding="{Binding DisplayManager}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>
      
       
    </DockPanel>
    <Border x:Name="Toast"
                Background="#7ace8a"
                CornerRadius="8"
                Padding="12,8"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="15"
                Opacity="0"
                Visibility="Collapsed">
            <TextBlock x:Name="ToastText"
                       Foreground="White"
                       FontSize="13"
                       TextWrapping="Wrap"/>
        </Border>

        </Grid>


</Window>
