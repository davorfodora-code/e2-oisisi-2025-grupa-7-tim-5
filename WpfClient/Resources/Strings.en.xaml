<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ===== APP ===== -->
    <sys:String x:Key="App_Title">Book Fair</sys:String>

    <!-- ===== MENU ===== -->
    <sys:String x:Key="Menu_File">File</sys:String>
    <sys:String x:Key="Menu_New">New</sys:String>
    <sys:String x:Key="Menu_Save">Save</sys:String>
    <sys:String x:Key="Menu_Open">Open</sys:String>
    <sys:String x:Key="Menu_Visitors">Visitors</sys:String>
    <sys:String x:Key="Menu_Books">Books</sys:String>
    <sys:String x:Key="Menu_Authors">Authors</sys:String>
    <sys:String x:Key="Menu_Publishers">Publishers</sys:String>
    <sys:String x:Key="Menu_EditRoot">Edit</sys:String>
    <sys:String x:Key="Menu_HelpRoot">Help</sys:String>
    <sys:String x:Key="Menu_Delete">Delete</sys:String>
    <sys:String x:Key="Menu_About">About</sys:String>
    <sys:String x:Key="Menu_Language">Language</sys:String>

    <!-- ===== TABS ===== -->
    <sys:String x:Key="Tab_Books">Books</sys:String>
    <sys:String x:Key="Tab_Visitors">Visitors</sys:String>
    <sys:String x:Key="Tab_Authors">Authors</sys:String>
    <sys:String x:Key="Tab_Publishers">Publishers</sys:String>

    <!-- ===== BUTTONS ===== -->
    <sys:String x:Key="Btn_CompareBooks">Compare Books</sys:String>
    <sys:String x:Key="Btn_SetPublisherManager">Set Publisher Manager</sys:String>
    <sys:String x:Key="Btn_ShowPublisherBooks">Publisher - Books</sys:String>
    <sys:String x:Key="Btn_ShowVisitorsByAuthor">Author - Visitors</sys:String>

    <!-- ===== STATUS BAR ===== -->
    <sys:String x:Key="Status_Date">Date:</sys:String>
    <sys:String x:Key="Status_Time">Time:</sys:String>
    <sys:String x:Key="Status_Tab">Tab:</sys:String>

    <!-- ===== DATA GRID - BOOKS ===== -->
    <sys:String x:Key="Col_ISBN">ISBN</sys:String>
    <sys:String x:Key="Col_Name">Name</sys:String>
    <sys:String x:Key="Col_Price">Price</sys:String>
    <sys:String x:Key="Col_Year">Year</sys:String>
    <sys:String x:Key="Col_Genre">Genre</sys:String>

    <!-- ===== DATA GRID - VISITORS ===== -->
    <sys:String x:Key="Col_MembershipNumber">Membership Number</sys:String>
    <sys:String x:Key="Col_FirstName">First Name</sys:String>
    <sys:String x:Key="Col_LastName">Last Name</sys:String>
    <sys:String x:Key="Col_Address">Address</sys:String>
    <sys:String x:Key="Col_Status">Status</sys:String>

    <!-- ===== DATA GRID - AUTHORS ===== -->
    <sys:String x:Key="Col_IdCard">ID Card</sys:String>
    <sys:String x:Key="Col_DateOfBirth">Date of Birth</sys:String>
    <sys:String x:Key="Col_Email">Email</sys:String>

    <!-- ===== DATA GRID - PUBLISHERS ===== -->
    <sys:String x:Key="Col_PublisherId">ID</sys:String>
    <sys:String x:Key="Col_PublisherName">Publisher Name</sys:String>
    <sys:String x:Key="Col_Manager">Manager</sys:String>

</ResourceDictionary>