<Window x:Class="WpfClient.VisitorsByAuthorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Posetioci sa knjigama izabranog autora"
        Height="500"
        Width="800"
        WindowStartupLocation="CenterOwner"
        Background="White">

	<Grid Margin="15">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<TextBlock Grid.Row="0"
                   Text="Posetioci koji imaju knjige izabranog autora"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

		<TextBlock Grid.Row="1"
                   x:Name="TxtAuthorInfo"
                   FontSize="14"
                   Margin="0,0,0,15"/>

		<Grid Grid.Row="2">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<Border Grid.Row="0"
                    Background="#F5F5F5"
                    Padding="8"
                    CornerRadius="4"
                    Margin="0,0,0,10">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="200"/>
						<ColumnDefinition Width="Auto"/>
					</Grid.ColumnDefinitions>

					<TextBlock Grid.Column="0"
                               Text="Pretraga:"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

					<TextBox Grid.Column="1"
                             x:Name="TxtSearch"
                             Height="28"
                             Padding="6"
                             KeyDown="TxtSearch_KeyDown"/>

					<Button Grid.Column="2"
                            x:Name="BtnSearch"
                            Content="Traži"
                            Width="60"
                            Height="28"
                            Margin="5,0,0,0"
                            Click="BtnSearch_Click"/>
				</Grid>
			</Border>

			<DataGrid Grid.Row="1"
                      x:Name="VisitorsGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      BorderBrush="#E0E0E0"
                      BorderThickness="1"
                      RowBackground="White"
                      AlternatingRowBackground="#F8F9FA"
                      FontSize="14"
                      RowHeight="30"
                      HeadersVisibility="Column"
                      VerticalGridLinesBrush="#E0E0E0"
                      HorizontalGridLinesBrush="#E0E0E0">

				<DataGrid.Columns>
					<DataGridTextColumn Header="Broj članske karte" Binding="{Binding MembershipNumber}" Width="120"/>
					<DataGridTextColumn Header="Ime" Binding="{Binding Name}" Width="100"/>
					<DataGridTextColumn Header="Prezime" Binding="{Binding LastName}" Width="100"/>
					<DataGridTextColumn Header="Status" Binding="{Binding DisplayStatus}" Width="80"/>
					<DataGridTextColumn Header="Adresa" Binding="{Binding DisplayAddress}" Width="*"/>
				</DataGrid.Columns>
			</DataGrid>
		</Grid>

		<StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
			<Button x:Name="BtnClose"
                    Content="Zatvori"
                    Width="100"
                    Height="35"
                    Click="BtnClose_Click"/>
		</StackPanel>
	</Grid>
</Window>