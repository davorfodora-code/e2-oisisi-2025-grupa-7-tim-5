<Window x:Class="WpfClient.PublisherAuthorsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource PublisherAuthors_Title}"
        Height="500" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Search -->
            <RowDefinition Height="*"/>     <!-- Grid -->
            <RowDefinition Height="Auto"/>  <!-- Close -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock x:Name="TxtHeader"
                   Grid.Row="0"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <!-- Search -->
        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"
                       Text="{DynamicResource PublisherAuthors_SearchLabel}"/>

            <TextBox x:Name="TxtSearch"
                     Height="28"
                     VerticalAlignment="Center"
                     TextChanged="TxtSearch_TextChanged"/>
        </DockPanel>

        <!-- Authors grid -->
        <DataGrid Grid.Row="2"
                  x:Name="AuthorsGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  BorderBrush="#E0E0E0"
                  BorderThickness="1"
                  RowHeight="30"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False">

            <DataGrid.Columns>

                <DataGridTextColumn Binding="{Binding FirstName}" Width="*">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource Col_FirstName}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn Binding="{Binding LastName}" Width="*">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource Col_LastName}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn Binding="{Binding BirthDate, StringFormat=dd.MM.yyyy}" Width="140">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource Col_DateOfBirth}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn Binding="{Binding Address}" Width="2*">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource Col_Address}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn Binding="{Binding Phone}" Width="140">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource Col_Phone}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn Binding="{Binding Email}" Width="2*">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource Col_Email}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- Close -->
        <Button Grid.Row="3"
                Content="{DynamicResource Btn_Close}"
                Width="90" Height="30"
                HorizontalAlignment="Right"
                Margin="0,10,0,0"
                Click="BtnClose_Click"/>
    </Grid>
</Window>
