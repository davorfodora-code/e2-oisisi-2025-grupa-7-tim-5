<Window x:Class="WpfClient.AddVisitorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dodaj posetioca"
        Height="600"
        Width="400"
        WindowStartupLocation="CenterOwner">

	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>


		<Label Grid.Row="0" Content="Broj clanske karte:"/>
		<TextBox Grid.Row="1" x:Name="TxtMembershipNumber" Margin="0,0,0,10"/>


		<Label Grid.Row="2" Content="Ime:"/>
		<TextBox Grid.Row="3" x:Name="TxtName" Margin="0,0,0,10"/>

		
		<Label Grid.Row="4" Content="Prezime:"/>
        <TextBox Grid.Row="5" x:Name="TxtLastName" Margin="0,0,0,10"/>

		<Label Grid.Row="6" Content="Status:"/>
		<ComboBox Grid.Row="7" x:Name="CmbStatus" Margin="0,0,0,10">
			<ComboBoxItem Content="Redovan" Tag="R"/>
			<ComboBoxItem Content="VIP" Tag="V"/>
		</ComboBox>

		
		<GroupBox Grid.Row="8" Header="Adresa" Margin="0,0,0,10">
			<StackPanel Margin="5">
				<Label Content="Ulica:"/>
				<TextBox x:Name="TxtStreet" Margin="0,0,0,5"/>
				<Label Content="Broj:"/>
				<TextBox x:Name="TxtNumber" Margin="0,0,0,5"/>
				<Label Content="Grad:"/>
				<TextBox x:Name="TxtCity" Margin="0,0,0,5"/>
				<Label Content="Opstina:"/>
				<TextBox x:Name="TxtState" Margin="0,0,0,5"/>
				<Label Content="Drzava:"/>
				<TextBox x:Name="TxtCountry" Text="Srbija"/>
			</StackPanel>
		</GroupBox>

		
		<StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
			<Button x:Name="BtnOk" Content="Sacuvaj" Width="80" Margin="0,0,10,0" Click="BtnOk_Click"/>
			<Button x:Name="BtnCancel" Content="Otkazi" Width="80" Click="BtnCancel_Click"/>
		</StackPanel>
	</Grid>
</Window>