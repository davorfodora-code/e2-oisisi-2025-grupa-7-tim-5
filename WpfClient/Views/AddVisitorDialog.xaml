<Window x:Class="WpfClient.AddVisitorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AddVisitor_Title}"
        Height="720"
        Width="420"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Membership Number -->
        <Label Grid.Row="0" Content="{DynamicResource AddVisitor_Lbl_MembershipNumber}"/>
        <TextBox Grid.Row="1" x:Name="TxtMembershipNumber" Margin="0,0,0,10"/>

        <!-- Name -->
        <Label Grid.Row="2" Content="{DynamicResource AddVisitor_Lbl_Name}"/>
        <TextBox Grid.Row="3" x:Name="TxtName" Margin="0,0,0,10"/>

        <!-- Last Name -->
        <Label Grid.Row="4" Content="{DynamicResource AddVisitor_Lbl_LastName}"/>
        <TextBox Grid.Row="5" x:Name="TxtLastName" Margin="0,0,0,10"/>

        <!-- ← NOVO: Datum rodjenja -->
        <Label Grid.Row="6" Content="{DynamicResource AddVisitor_Lbl_DateOfBirth}"/>
        <DatePicker Grid.Row="7" x:Name="DpDateOfBirth" Margin="0,0,0,10"
                    SelectedDateFormat="Short"
                    DisplayDateEnd="{x:Static sys:DateTime.Today}"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"/>

        <!-- ← NOVO: Kontakt telefon -->
        <Label Grid.Row="8" Content="{DynamicResource AddVisitor_Lbl_ContactPhone}"/>
        <TextBox Grid.Row="9" x:Name="TxtContactPhone" Margin="0,0,0,10"/>

        <!-- ← NOVO: Email -->
        <Label Grid.Row="10" Content="{DynamicResource AddVisitor_Lbl_Email}"/>
        <TextBox Grid.Row="11" x:Name="TxtEmail" Margin="0,0,0,10"/>

        <!-- Status + Address u GroupBox -->
        <GroupBox Grid.Row="12" Margin="0,0,0,10">
            <GroupBox.Header>
                <TextBlock Text="{DynamicResource AddVisitor_Gb_Details}"/>
            </GroupBox.Header>
            <StackPanel Margin="5">
                <Label Content="{DynamicResource AddVisitor_Lbl_Status}"/>
                <ComboBox x:Name="CmbStatus" Margin="0,0,0,8">
                    <ComboBoxItem Content="{DynamicResource AddVisitor_Status_Regular}" Tag="R"/>
                    <ComboBoxItem Content="{DynamicResource AddVisitor_Status_VIP}" Tag="V"/>
                </ComboBox>

                <GroupBox Header="{DynamicResource AddVisitor_Gb_Address}">
                    <StackPanel Margin="5">
                        <Label Content="{DynamicResource AddVisitor_Lbl_Street}"/>
                        <TextBox x:Name="TxtStreet" Margin="0,0,0,5"/>
                        <Label Content="{DynamicResource AddVisitor_Lbl_Number}"/>
                        <TextBox x:Name="TxtNumber" Margin="0,0,0,5"/>
                        <Label Content="{DynamicResource AddVisitor_Lbl_City}"/>
                        <TextBox x:Name="TxtCity" Margin="0,0,0,5"/>
                        <Label Content="{DynamicResource AddVisitor_Lbl_State}"/>
                        <TextBox x:Name="TxtState" Margin="0,0,0,5"/>
                        <Label Content="{DynamicResource AddVisitor_Lbl_Country}"/>
                        <TextBox x:Name="TxtCountry" Text="Srbija"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="13" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnOk" Content="{DynamicResource Btn_Save}" Width="80"
                    Margin="0,0,10,0" Click="BtnOk_Click"/>
            <Button x:Name="BtnCancel" Content="{DynamicResource Btn_Cancel}"
                    Width="80" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
