<Window x:Class="WpfClient.PublisherBooksDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Knjige izdavača"
        Height="450"
        Width="800"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtHeader"
                   Grid.Row="0"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <DataGrid Grid.Row="1"
                  x:Name="BooksGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  BorderBrush="#E0E0E0"
                  BorderThickness="1"
                  RowHeight="30">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ISBN" Binding="{Binding Isbn}" Width="140"/>
                <DataGridTextColumn Header="Naziv" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Godina" Binding="{Binding PublicationYear}" Width="100"/>
                <DataGridTextColumn Header="Žanr" Binding="{Binding Genre}" Width="120"/>
                <DataGridTextColumn Header="Cena" Binding="{Binding Price, StringFormat='{}{0:C}'}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2"
                Content="Zatvori"
                Width="90"
                Height="30"
                HorizontalAlignment="Right"
                Margin="0,10,0,0"
                Click="BtnClose_Click"/>
    </Grid>
</Window>
