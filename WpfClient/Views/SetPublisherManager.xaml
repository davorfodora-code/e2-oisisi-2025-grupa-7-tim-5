<Window x:Class="WpfClient.SetPublisherManager"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource SetManager_Title}"
        Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource SetManager_Header}"
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource SetManager_Lbl_Publisher}" VerticalAlignment="Center"/>
            <ComboBox Grid.Row="0" Grid.Column="1" x:Name="CmbPublisher" DisplayMemberPath="Name"
                      Height="30" SelectionChanged="CmbPublisher_SelectionChanged"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource SetManager_Lbl_CurrentManager}"
                       VerticalAlignment="Center" Margin="0,10,0,0"/>
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtCurrentManager" Margin="0,10,0,0"/>
        </Grid>

        <GroupBox Grid.Row="2" Padding="5">
            <GroupBox.Header>
                <TextBlock Text="{DynamicResource SetManager_Gb_Authors}"/>
            </GroupBox.Header>
            <DataGrid x:Name="AuthorsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      BorderBrush="#CCCCCC" BorderThickness="1" RowHeight="30"
                      SelectionChanged="AuthorsGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding Name}" Width="100">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Col_FirstName}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Lastname}" Width="100">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Col_LastName}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding ExperienceLength}" Width="120">
                        <DataGridTextColumn.Header>
                            <TextBlock Text="{DynamicResource Col_ExperienceYears}"/>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="BtnSetManager" Content="{DynamicResource Btn_SetManager}"
                    Width="120" Height="35" Margin="0,0,10,0" IsEnabled="False"
                    Click="BtnSetManager_Click"/>
            <Button x:Name="BtnCancel" Content="{DynamicResource Btn_Close}"
                    Width="100" Height="35" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
