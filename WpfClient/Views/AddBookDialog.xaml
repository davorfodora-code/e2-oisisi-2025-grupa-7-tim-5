<Window x:Class="WpfClient.AddBookDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AddBook_Title}"
        Height="620"
        Width="500"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <Label Grid.Row="0" Grid.Column="0" Content="{DynamicResource AddBook_Lbl_ISBN}" VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtIsbn" Margin="0,2" Padding="3"/>

        <Label Grid.Row="1" Grid.Column="0" Content="{DynamicResource AddBook_Lbl_Name}" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtBookName" Margin="0,2" Padding="3"/>

        <Label Grid.Row="2" Grid.Column="0" Content="{DynamicResource AddBook_Lbl_Authors}"
               VerticalAlignment="Top" Margin="0,6,0,0"/>
        <Grid Grid.Row="2" Grid.Column="1" Margin="0,2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderBrush="#AAAAAA" BorderThickness="1"
                    MinHeight="32" MaxHeight="130" Margin="0,0,0,4">
                <ListBox x:Name="LstSelectedAuthors"
                         BorderThickness="0"
                         SelectionMode="Single"
                         SelectionChanged="LstSelectedAuthors_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="4,3"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding FullName}"
                                           FontSize="13" VerticalAlignment="Center"/>
                           <Button Grid.Column="1"
                                        Content="−"
                                        Width="22" Height="22"
                                        FontSize="14" Padding="0"
                                        Margin="6,0,0,0"
                                        Tag="{Binding}"
                                        Click="BtnRemoveAuthor_Click"
                                        IsEnabled="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                        ToolTip="{DynamicResource Tooltip_RemoveAuthor}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>


            <Button Grid.Row="1"
                    x:Name="BtnAddAuthor"
                    Content="+"
                    Width="28" Height="24"
                    FontSize="16" Padding="0"
                    HorizontalAlignment="Left"
                    Visibility="Collapsed"
                    Click="BtnAddAuthor_Click"
                    ToolTip="{DynamicResource Tooltip_AddAuthor}"/>
        </Grid>


        <Label Grid.Row="3" Grid.Column="0" Content="{DynamicResource AddBook_Lbl_Genre}" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="CmbGenre" Margin="0,2" Padding="3"/>

        <Label Grid.Row="4" Grid.Column="0" Content="{DynamicResource AddBook_Lbl_Year}" VerticalAlignment="Center"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtPublicationYear" Margin="0,2" Padding="3"/>

        <Label Grid.Row="5" Grid.Column="0" Content="{DynamicResource AddBook_Lbl_Price}" VerticalAlignment="Center"/>
        <TextBox Grid.Row="5" Grid.Column="1" x:Name="TxtPrice" Margin="0,2" Padding="3"/>

        <Label Grid.Row="6" Grid.Column="0" Content="{DynamicResource AddBook_Lbl_Pages}" VerticalAlignment="Center"/>
        <TextBox Grid.Row="6" Grid.Column="1" x:Name="TxtPages" Margin="0,2" Padding="3"/>

        <Label Grid.Row="7" Grid.Column="0" Content="{DynamicResource AddBook_Lbl_Publisher}" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="7" Grid.Column="1" x:Name="CmbPublisher"
                  DisplayMemberPath="Name" Margin="0,2" Padding="3" IsEditable="False"/>

        <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnSave" Content="{DynamicResource Btn_Save}"
                    Width="90" Height="30" Margin="0,0,10,0"
                    Click="BtnSave_Click" IsDefault="True"/>
            <Button x:Name="BtnCancel" Content="{DynamicResource Btn_Cancel}"
                    Width="90" Height="30" Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
