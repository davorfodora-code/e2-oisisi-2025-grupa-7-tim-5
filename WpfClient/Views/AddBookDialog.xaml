<Window x:Class="WpfClient.AddBookDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AddBook_Title}"
        Height="680"
        Width="420"
        Background="White"
        WindowStartupLocation="CenterOwner">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18,14,18,14">

            <TextBlock Text="{DynamicResource AddBook_Lbl_ISBN}"
                       Foreground="Black" FontWeight="SemiBold" Margin="0,0,0,3"/>
            <TextBox x:Name="TxtIsbn"
                     Padding="5,4" Margin="0,0,0,10"
                     Foreground="Black" Background="White"/>

            <TextBlock Text="{DynamicResource AddBook_Lbl_Name}"
                       Foreground="Black" FontWeight="SemiBold" Margin="0,0,0,3"/>
            <TextBox x:Name="TxtBookName"
                     Padding="5,4" Margin="0,0,0,10"
                     Foreground="Black" Background="White"/>

            <TextBlock Text="{DynamicResource AddBook_Lbl_Authors}"
                       Foreground="Black" FontWeight="SemiBold" Margin="0,0,0,3"/>
            <Border BorderBrush="#AAAAAA" BorderThickness="1"
                    MinHeight="32" MaxHeight="120" Margin="0,0,0,4">
                <ListBox x:Name="LstSelectedAuthors"
                         BorderThickness="0"
                         Background="White"
                         SelectionMode="Single"
                         SelectionChanged="LstSelectedAuthors_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="4,3"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding FullName}"
                                           Foreground="Black" FontSize="13"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Content="−" Width="22" Height="22"
                                        FontSize="14" Padding="0" Margin="6,0,0,0"
                                        Tag="{Binding}"
                                        Click="BtnRemoveAuthor_Click"
                                        IsEnabled="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                        ToolTip="{DynamicResource Tooltip_RemoveAuthor}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <Button x:Name="BtnAddAuthor"
                    Content="+"
                    Width="28" Height="24"
                    FontSize="16" Padding="0"
                    HorizontalAlignment="Left"
                    Visibility="Collapsed"
                    Margin="0,0,0,10"
                    Click="BtnAddAuthor_Click"
                    ToolTip="{DynamicResource Tooltip_AddAuthor}"/>

            <TextBlock Text="{DynamicResource AddBook_Lbl_Genre}"
                       Foreground="Black" FontWeight="SemiBold" Margin="0,0,0,3"/>
            <ComboBox x:Name="CmbGenre"
                      Padding="5,4" Margin="0,0,0,10"
                      Foreground="Black" Background="White"/>

            <TextBlock Text="{DynamicResource AddBook_Lbl_Year}"
                       Foreground="Black" FontWeight="SemiBold" Margin="0,0,0,3"/>
            <TextBox x:Name="TxtPublicationYear"
                     Padding="5,4" Margin="0,0,0,10"
                     Foreground="Black" Background="White"/>

            <TextBlock Text="{DynamicResource AddBook_Lbl_Price}"
                       Foreground="Black" FontWeight="SemiBold" Margin="0,0,0,3"/>
            <TextBox x:Name="TxtPrice"
                     Padding="5,4" Margin="0,0,0,10"
                     Foreground="Black" Background="White"/>

            <TextBlock Text="{DynamicResource AddBook_Lbl_Pages}"
                       Foreground="Black" FontWeight="SemiBold" Margin="0,0,0,3"/>
            <TextBox x:Name="TxtPages"
                     Padding="5,4" Margin="0,0,0,10"
                     Foreground="Black" Background="White"/>

            <TextBlock Text="{DynamicResource AddBook_Lbl_Publisher}"
                       Foreground="Black" FontWeight="SemiBold" Margin="0,0,0,3"/>
            <ComboBox x:Name="CmbPublisher"
                      DisplayMemberPath="Name"
                      Padding="5,4" Margin="0,0,0,18"
                      Foreground="Black" Background="White"
                      IsEditable="False"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnSave"
                        Content="{DynamicResource Btn_Save}"
                        Width="90" Height="30"
                        Margin="0,0,10,0"
                        Click="BtnSave_Click"
                        IsDefault="True"/>
                <Button x:Name="BtnCancel"
                        Content="{DynamicResource Btn_Cancel}"
                        Width="90" Height="30"
                        Click="BtnCancel_Click"
                        IsCancel="True"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
