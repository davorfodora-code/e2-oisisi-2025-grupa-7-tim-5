<Window x:Class="WpfClient.AddBookDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AddBook_Title}"
        Height="650"
        Width="500"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="{DynamicResource AddBook_Lbl_ISBN}" VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtIsbn" Margin="0,2" Padding="3"/>

        <Label Grid.Row="1" Grid.Column="0" Content="{DynamicResource AddBook_Lbl_Name}" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtBookName" Margin="0,2" Padding="3"/>

        <Label Grid.Row="2" Grid.Column="0" Content="{DynamicResource AddBook_Lbl_Authors}" VerticalAlignment="Top" Margin="0,5,0,0"/>
        <GroupBox Grid.Row="2" Grid.Column="1" Header="{DynamicResource AddBook_Gb_SelectAuthors}" Margin="0,2" Padding="5">
            <ListBox x:Name="LstAuthors" 
                     SelectionMode="Multiple"
                     BorderThickness="0"
                     Background="Transparent"
                     MaxHeight="200"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding FullName}" 
                                  IsChecked="{Binding IsSelected, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                  Margin="2"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </GroupBox>

        <Label Grid.Row="3" Grid.Column="0" Content="{DynamicResource AddBook_Lbl_Genre}" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="CmbGenre" Margin="0,2" Padding="3"/>

        <Label Grid.Row="4" Grid.Column="0" Content="{DynamicResource AddBook_Lbl_Year}" VerticalAlignment="Center"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtPublicationYear" Margin="0,2" Padding="3"/>

        <Label Grid.Row="5" Grid.Column="0" Content="{DynamicResource AddBook_Lbl_Price}" VerticalAlignment="Center"/>
        <TextBox Grid.Row="5" Grid.Column="1" x:Name="TxtPrice" Margin="0,2" Padding="3"/>

        <Label Grid.Row="6" Grid.Column="0" Content="{DynamicResource AddBook_Lbl_Pages}" VerticalAlignment="Center"/>
        <TextBox Grid.Row="6" Grid.Column="1" x:Name="TxtPages" Margin="0,2" Padding="3"/>

        <Label Grid.Row="7" Grid.Column="0" Content="{DynamicResource AddBook_Lbl_Publisher}" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="7" Grid.Column="1" x:Name="CmbPublisher" 
          DisplayMemberPath="Name"
          Margin="0,2" 
          Padding="3"
          IsEditable="False"/>

        <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="BtnSave" Content="{DynamicResource Btn_Save}" Width="90" Height="30" Margin="0,0,10,0" Click="BtnSave_Click" IsDefault="True"/>
            <Button x:Name="BtnCancel" Content="{DynamicResource Btn_Cancel}" Width="90" Height="30" Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>