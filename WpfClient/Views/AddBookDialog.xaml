<Window x:Class="WpfClient.AddBookDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dodaj knjigu"
        Height="600"
        Width="450"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="ISBN:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtIsbn" Margin="0,2"/>

        <Label Grid.Row="1" Grid.Column="0" Content="Naziv:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtBookName" Margin="0,2"/>

        <Label Grid.Row="2" Grid.Column="0" Content="Autori:" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CmbAuthors" Margin="0,2" DisplayMemberPath="Name"/>

        <Label Grid.Row="3" Grid.Column="0" Content="Žanr:" VerticalAlignment="Center"/>
        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="CmbGenre" Margin="0,2"/>

        <Label Grid.Row="4" Grid.Column="0" Content="Godina izdanja:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtPublicationYear" Margin="0,2"/>

        <Label Grid.Row="5" Grid.Column="0" Content="Cena:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="5" Grid.Column="1" x:Name="TxtPrice" Margin="0,2"/>

        <Label Grid.Row="6" Grid.Column="0" Content="Broj stranica:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="6" Grid.Column="1" x:Name="TxtPages" Margin="0,2"/>

        <Label Grid.Row="7" Grid.Column="0" Content="Izdavač:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="7" Grid.Column="1" x:Name="TxtPublisher" Margin="0,2"/>

        <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="BtnSave" Content="Sačuvaj" Width="90" Margin="0,0,10,0" Click="BtnSave_Click"/>
            <Button x:Name="BtnCancel" Content="Otkaži" Width="90" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>