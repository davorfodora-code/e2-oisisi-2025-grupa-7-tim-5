<Window x:Class="WpfClient.AuthorEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AuthorEdit_Title}"
        Height="650" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,10">

            <TabItem Header="{DynamicResource AuthorEdit_Tab_Info}" FontSize="14" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="{DynamicResource AuthorEdit_Lbl_IdCard}" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtIdCard" Margin="5" IsEnabled="False"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="{DynamicResource AuthorEdit_Lbl_Name}" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtName" Margin="5"/>

                        <Label Grid.Row="2" Grid.Column="0" Content="{DynamicResource AuthorEdit_Lbl_LastName}" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtLastName" Margin="5"/>

                        <Label Grid.Row="3" Grid.Column="0" Content="{DynamicResource AuthorEdit_Lbl_DateOfBirth}" FontWeight="SemiBold"/>
                        <DatePicker Grid.Row="3" Grid.Column="1" x:Name="DpDateOfBirth" Margin="5" Height="25"/>

                        <Label Grid.Row="4" Grid.Column="0" Content="{DynamicResource AuthorEdit_Lbl_Phone}" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtPhoneNumber" Margin="5"/>

                        <Label Grid.Row="5" Grid.Column="0" Content="{DynamicResource AuthorEdit_Lbl_Email}" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="TxtEmail" Margin="5"/>

                        <Label Grid.Row="6" Grid.Column="0" Content="{DynamicResource AuthorEdit_Lbl_Experience}" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="6" Grid.Column="1" x:Name="TxtExperienceLength" Margin="5"/>

                        <Label Grid.Row="7" Grid.Column="0" Content="{DynamicResource AuthorEdit_Lbl_Street}" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="7" Grid.Column="1" x:Name="TxtStreet" Margin="5"/>

                        <Label Grid.Row="8" Grid.Column="0" Content="{DynamicResource AuthorEdit_Lbl_Number}" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="8" Grid.Column="1" x:Name="TxtNumber" Margin="5"/>

                        <Label Grid.Row="9" Grid.Column="0" Content="{DynamicResource AuthorEdit_Lbl_City}" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="9" Grid.Column="1" x:Name="TxtCity" Margin="5"/>

                        <Label Grid.Row="10" Grid.Column="0" Content="{DynamicResource AuthorEdit_Lbl_State}" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="10" Grid.Column="1" x:Name="TxtState" Margin="5"/>

                        <Label Grid.Row="11" Grid.Column="0" Content="{DynamicResource AuthorEdit_Lbl_Country}" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="11" Grid.Column="1" x:Name="TxtCountry" Margin="5" Text="Srbija"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{DynamicResource AuthorEdit_Tab_Books}" FontSize="14" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1"
                            CornerRadius="5" Padding="10" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource AuthorEdit_Lbl_AddBook}"
                                       FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox Grid.Column="1" x:Name="CmbAvailableBooks" DisplayMemberPath="Name"
                                      Margin="0,0,10,0" Height="30"/>
                            <Button Grid.Column="2" x:Name="BtnAddBook" Content="{DynamicResource Btn_Add}"
                                    Width="80" Height="30" Click="BtnAddBook_Click"/>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1" x:Name="BooksGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              Margin="0,0,0,10" RowHeight="35" BorderBrush="#E0E0E0" BorderThickness="1"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ISBN" Binding="{Binding Isbn}" Width="150"/>
                            <DataGridTextColumn Binding="{Binding Name}" Width="*">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{DynamicResource Col_Name}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding PublicationYear}" Width="100">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{DynamicResource Col_Year}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding Genre}" Width="120">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{DynamicResource Col_Genre}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Width="80">
                                <DataGridTemplateColumn.Header>
                                    <TextBlock Text="{DynamicResource Col_Action}"/>
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{DynamicResource Btn_Remove}"
                                                Click="BtnRemoveBook_Click" Padding="5,2" FontSize="11"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnSave" Content="{DynamicResource Btn_SaveChanges}" Width="120" Height="35"
                    Margin="0,0,10,0" Click="BtnSave_Click" FontWeight="SemiBold"/>
            <Button x:Name="BtnCancel" Content="{DynamicResource Btn_Cancel}" Width="100" Height="35"
                    Click="BtnCancel_Click" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
