<Window x:Class="WpfClient.VisitorEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="{DynamicResource VisitorEdit_Title}"
        Height="720"
        Width="980"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0"
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    Margin="0,0,0,10">


            <TabItem FontSize="14" Padding="10">
                <TabItem.Header>
                    <TextBlock Text="{DynamicResource VisitorEdit_Tab_Info}"/>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="15">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                     </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="165"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="{DynamicResource VisitorEdit_Lbl_MembershipNumber}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtMembershipNumber" Margin="5" IsEnabled="False" Height="30" Foreground="Black" Background="White"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="{DynamicResource VisitorEdit_Lbl_MembershipYear}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtMembershipYear" Margin="5" Height="30" Foreground="Black" Background="White"/>

                        <Label Grid.Row="2" Grid.Column="0" Content="{DynamicResource VisitorEdit_Lbl_Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtName" Margin="5" Height="30" Foreground="Black" Background="White"/>

                        <Label Grid.Row="3" Grid.Column="0" Content="{DynamicResource VisitorEdit_Lbl_LastName}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtLastName" Margin="5" Height="30" Foreground="Black" Background="White"/>


                        <Label Grid.Row="4" Grid.Column="0" Content="{DynamicResource VisitorEdit_Lbl_DateOfBirth}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <DatePicker Grid.Row="4" Grid.Column="1" x:Name="DpDateOfBirth" Margin="5" Height="30"
                                    SelectedDateFormat="Short"
                                    DisplayDateEnd="{x:Static sys:DateTime.Today}"/>


                        <Label Grid.Row="5" Grid.Column="0" Content="{DynamicResource VisitorEdit_Lbl_ContactPhone}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="TxtContactPhone" Margin="5" Height="30" Foreground="Black" Background="White"/>


                        <Label Grid.Row="6" Grid.Column="0" Content="{DynamicResource VisitorEdit_Lbl_Email}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="6" Grid.Column="1" x:Name="TxtEmail" Margin="5" Height="30" Foreground="Black" Background="White"/>

                        <Label Grid.Row="7" Grid.Column="0" Content="{DynamicResource VisitorEdit_Lbl_Street}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="7" Grid.Column="1" x:Name="TxtStreet" Margin="5" Height="30" Foreground="Black" Background="White"/>

                        <Label Grid.Row="8" Grid.Column="0" Content="{DynamicResource VisitorEdit_Lbl_Number}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="8" Grid.Column="1" x:Name="TxtStreetNumber" Margin="5" Height="30" Foreground="Black" Background="White"/>

                        <Label Grid.Row="9" Grid.Column="0" Content="{DynamicResource VisitorEdit_Lbl_City}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="9" Grid.Column="1" x:Name="TxtCity" Margin="5" Height="30" Foreground="Black" Background="White"/>

                        <Label Grid.Row="10" Grid.Column="0" Content="{DynamicResource VisitorEdit_Lbl_Country}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="10" Grid.Column="1" x:Name="TxtCountry" Margin="5" Height="30" Foreground="Black" Background="White"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>

         <TabItem FontSize="14" Padding="10">
                <TabItem.Header>
                    <TextBlock Text="{DynamicResource VisitorEdit_Tab_Purchased}"/>
                </TabItem.Header>
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0"
                            x:Name="BtnCancelPurchase"
                            Content="{DynamicResource Btn_CancelPurchase}"
                            Width="150" Height="32"
                            IsEnabled="False"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,8"
                            Click="BtnCancelPurchase_Click"/>

                    <DataGrid Grid.Row="1"
                              x:Name="PurchasedBooksGrid"
                              SelectionChanged="PurchasedBooksGrid_SelectionChanged"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              RowHeight="32"
                              FontSize="13"
                              BorderBrush="#E0E0E0"
                              BorderThickness="1"
                              AlternatingRowBackground="#F8F9FA">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ISBN" Binding="{Binding Book.Isbn}" Width="120"/>
                            <DataGridTextColumn Binding="{Binding Book.Name}" Width="2*">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{DynamicResource Col_Name}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding DateOfPurchase, StringFormat='dd.MM.yyyy.'}" Width="110">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{DynamicResource Col_Date}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding Review}" Width="70">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{DynamicResource Col_Review}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding Book.Price, StringFormat='{}{0:N2} RSD'}" Width="110">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{DynamicResource Col_Price}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding Comment}" Width="*">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{DynamicResource Col_Comment}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                VerticalAlignment="Center" HorizontalAlignment="Right"
                                Margin="0,8,0,0">
                        <TextBlock Text="{DynamicResource VisitorEdit_Lbl_TotalSpent}"
                                   FontWeight="Bold" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtTotalSpent" FontWeight="Bold" FontSize="16"
                                   Foreground="#4CAF50" Margin="0,0,25,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource VisitorEdit_Lbl_AvgReview}"
                                   FontWeight="Bold" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtAverageReview" FontWeight="Bold" FontSize="16"
                                   Foreground="#FF9800" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </TabItem>


            <TabItem FontSize="14" Padding="10">
                <TabItem.Header>
                    <TextBlock Text="{DynamicResource VisitorEdit_Tab_Wishlist}"/>
                </TabItem.Header>
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

 
                    <Border Grid.Row="0"
                            Background="#F8F9FA"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10,8"
                            Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="BtnAddToWishlist"
                                    Content="{DynamicResource Btn_Add}"
                                    Width="100" Height="32"
                                    Margin="0,0,8,0"
                                    Click="BtnAddToWishlist_Click"/>
                            <Button x:Name="BtnPurchase"
                                    Content="{DynamicResource Btn_Purchase}"
                                    Width="110" Height="32"
                                    Margin="0,0,8,0"
                                    IsEnabled="False"
                                    Click="BtnPurchase_Click"/>
                            <Button x:Name="BtnDeleteFromWishlist"
                                    Content="{DynamicResource Btn_Delete}"
                                    Width="100" Height="32"
                                    IsEnabled="False"
                                    Click="BtnDeleteFromWishlist_Click"/>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1"
                              x:Name="WishlistBooksGrid"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              SelectionChanged="WishlistBooksGrid_SelectionChanged"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              BorderBrush="#E0E0E0"
                              BorderThickness="1"
                              RowHeight="38"
                              FontSize="13"
                              AlternatingRowBackground="#F8F9FA"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E0E0E0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ISBN" Binding="{Binding Isbn}" Width="130"/>
                            <DataGridTextColumn Binding="{Binding Name}" Width="2*">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{DynamicResource Col_Name}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding DisplayAuthors}" Width="2*">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{DynamicResource Col_Authors}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding DisplayPublisher}" Width="*">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{DynamicResource Col_Publisher}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <DataGridTextColumn Binding="{Binding Price, StringFormat='{}{0:N2} RSD'}" Width="110">
                                <DataGridTextColumn.Header>
                                    <TextBlock Text="{DynamicResource Col_Price}"/>
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="BtnSave"
                    Content="{DynamicResource Btn_SaveChanges}"
                    Width="130" Height="36"
                    Margin="0,0,10,0"
                    Click="BtnSave_Click"/>
            <Button x:Name="BtnCancel"
                    Content="{DynamicResource Btn_Cancel}"
                    Width="100" Height="36"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
