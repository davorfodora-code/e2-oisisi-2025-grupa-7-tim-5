<Window x:Class="WpfClient.VisitorEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Izmena posetioca"
        Height="650"
        Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <TabControl Grid.Row="0" 
                    Background="White"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    Margin="0,0,0,10">


            <TabItem Header="Informacije" FontSize="14" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="Broj članske karte:" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtMembershipNumber" Margin="5" IsEnabled="False"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="Godina učlanjenja:" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtMembershipYear" Margin="5"/>

                        <Label Grid.Row="2" Grid.Column="0" Content="Ime:" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtName" Margin="5"/>

                        <Label Grid.Row="3" Grid.Column="0" Content="Prezime:" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtLastName" Margin="5"/>

                        <Label Grid.Row="4" Grid.Column="0" Content="Datum rođenja:" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtDateOfBirth" Margin="5"/>

                        <Label Grid.Row="5" Grid.Column="0" Content="Ulica:" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="TxtStreet" Margin="5"/>

                        <Label Grid.Row="6" Grid.Column="0" Content="Broj:" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="6" Grid.Column="1" x:Name="TxtStreetNumber" Margin="5"/>

                        <Label Grid.Row="7" Grid.Column="0" Content="Grad:" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="7" Grid.Column="1" x:Name="TxtCity" Margin="5"/>

                        <Label Grid.Row="8" Grid.Column="0" Content="Država:" FontWeight="SemiBold"/>
                        <TextBox Grid.Row="8" Grid.Column="1" x:Name="TxtCountry" Margin="5"/>

                      
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Kupljene" FontSize="14" Padding="10" Height="39" VerticalAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
    <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="*"/>
</Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
            x:Name="BtnCancelPurchase"
            Content="Poništi kupovinu"
            Width="140"
            Height="30"
            IsEnabled="False"
            HorizontalAlignment="Left"
            Click="BtnCancelPurchase_Click" VerticalAlignment="Center"/>
            </Grid>

                    <DataGrid Grid.Row="1" 
                              x:Name="PurchasedBooksGrid"
                              SelectionChanged="PurchasedBooksGrid_SelectionChanged"
SelectionMode="Single"
SelectionUnit="FullRow"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Margin="0,0,0,10"
                              RowHeight="30"
                              BorderBrush="#E0E0E0"
                              BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ISBN" Binding="{Binding Book.Isbn}" Width="120"/>
                            <DataGridTextColumn Header="Naziv" Binding="{Binding Book.Name}" Width="*"/>
                            <DataGridTextColumn Header="Datum" Binding="{Binding DateOfPurchase, StringFormat='dd.MM.yyyy.'}" Width="120"/>
                            <DataGridTextColumn Header="Ocena" Binding="{Binding Review}" Width="80"/>
                            <DataGridTextColumn Header="Cena" Binding="{Binding Book.Price, StringFormat='{}{0:C}'}" Width="100"/>
                            <DataGridTextColumn Header="Komentar" Binding="{Binding Comment}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Potrošeno:" FontWeight="Bold" FontSize="14" Margin="0,0,10,0"/>
                        <TextBlock x:Name="TxtTotalSpent" 
                                  FontWeight="Bold" 
                                  FontSize="16" 
                                  Foreground="#4CAF50"/>
                    </StackPanel>
                </Grid>
            </TabItem>

   
            <TabItem Header="Želje" FontSize="14" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                   <Border Grid.Row="0"
        Background="#F8F9FA"
        BorderBrush="#E0E0E0"
        BorderThickness="1"
        CornerRadius="5"
        Padding="10"
        Margin="0,0,0,10">
    <Grid>

        <Grid.ColumnDefinitions>
            
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
             <ColumnDefinition Width="Auto"/>
             <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
      
           

        <Button Grid.Column="0"
                x:Name="BtnAddToWishlist"
                Content="Dodaj"
                Width="90"
                Height="30"
                Margin="10,0,0,0"
                Click="BtnAddToWishlist_Click"/>

        <Button Grid.Column="1"
                x:Name="BtnPurchase"
                Content="Kupovina"
                Width="100"
                Height="30"
                Margin="10,0,0,0"
                IsEnabled="False"
                Click="BtnPurchase_Click"/>

         <Button Grid.Column="2" 
             x:Name="BtnDeleteFromWishlist"
              Content="Obriši"
             Width="90"
             Height="30"
             Margin="10,0,0,0"
            IsEnabled="False"
             Click="BtnDeleteFromWishlist_Click"/>
        
    </Grid>
</Border>

                    

                    <DataGrid Grid.Row="2"
                              x:Name="WishlistBooksGrid"
                               SelectionMode="Single"
          SelectionUnit="FullRow"
          SelectionChanged="WishlistBooksGrid_SelectionChanged"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              BorderBrush="#E0E0E0"
                              BorderThickness="1"
                              RowHeight="35">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ISBN" Binding="{Binding Isbn}" Width="120"/>
                            <DataGridTextColumn Header="Naziv" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Autor(i)" Binding="{Binding DisplayAuthors}" Width="*"/>
                            <DataGridTextColumn Header="Cena" Binding="{Binding Price, StringFormat='{}{0:C}'}" Width="100"/>
                           
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right">
            <Button x:Name="BtnSave" 
                    Content="Sačuvaj izmene" 
                    Width="120" 
                    Height="35"
                    Margin="0,0,10,0"
                    Click="BtnSave_Click"/>
            <Button x:Name="BtnCancel" 
                    Content="Otkaži" 
                    Width="100" 
                    Height="35"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>