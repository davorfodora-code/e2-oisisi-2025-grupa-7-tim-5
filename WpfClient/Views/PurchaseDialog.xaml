<Window x:Class="WpfClient.PurchaseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kupovina knjige"
        Height="260"
        Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">
   <Grid Margin="15">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/> <!-- 0 ISBN -->
        <RowDefinition Height="Auto"/> <!-- 1 Naziv -->
        <RowDefinition Height="Auto"/> <!-- 2 Ocena -->
        <RowDefinition Height="Auto"/> <!-- 3 Error -->
        <RowDefinition Height="Auto"/> <!-- 4 Datum -->
        <RowDefinition Height="Auto"/> <!-- 5 Dugmad -->
    </Grid.RowDefinitions>

    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="120"/>
        <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <TextBlock Grid.Row="0" Grid.Column="0" Text="ISBN *" VerticalAlignment="Center" />
    <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtIsbn" Margin="5" IsReadOnly="True"/>

    <TextBlock Grid.Row="1" Grid.Column="0" Text="Naziv *" VerticalAlignment="Center" />
    <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtNaziv" Margin="5" IsReadOnly="True"/>

    <TextBlock Grid.Row="2" Grid.Column="0" Text="Ocena *" VerticalAlignment="Center" />
    <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtOcena" Margin="5"
             PreviewTextInput="TxtOcena_PreviewTextInput"
             TextChanged="AnyFieldChanged"/>

    <TextBlock Grid.Row="3" Grid.Column="1"
               x:Name="TxtOcenaError"
               Foreground="Red"
               FontSize="11"
               Margin="5,2,5,0"
               Visibility="Collapsed"
               Text="Ocena vam mora biti u rangu od 1 do 5"/>

    <TextBlock Grid.Row="4" Grid.Column="0" Text="Datum kupovine *" VerticalAlignment="Center" />
    <DatePicker Grid.Row="4" Grid.Column="1" x:Name="DpDatum" Margin="5"
                SelectedDateChanged="DpDatum_SelectedDateChanged"/>

    <StackPanel Grid.Row="5" Grid.ColumnSpan="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,15,0,0">
        <Button Content="Odustani" Width="90" Margin="0,0,10,0" Click="BtnCancel_Click"/>
        <Button x:Name="BtnConfirm" Content="Potvrdi" Width="90" IsEnabled="False" Click="BtnConfirm_Click"/>
    </StackPanel>
</Grid>
</Window>
