<Window x:Class="WpfClient.PurchaseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Purchase_Title}"
        Height="260" Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Purchase_Lbl_ISBN}" VerticalAlignment="Center"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtIsbn" Margin="5" IsReadOnly="True"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Purchase_Lbl_Name}" VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtNaziv" Margin="5" IsReadOnly="True"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Purchase_Lbl_Review}" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtOcena" Margin="5"
                 PreviewTextInput="TxtOcena_PreviewTextInput" TextChanged="AnyFieldChanged"/>

        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtOcenaError" Foreground="Red" FontSize="11"
                   Margin="5,2,5,0" Visibility="Collapsed"
                   Text="{DynamicResource Purchase_ReviewError}"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource Purchase_Lbl_Date}" VerticalAlignment="Center"/>
        <DatePicker Grid.Row="4" Grid.Column="1" x:Name="DpDatum" Margin="5"
                    SelectedDateChanged="DpDatum_SelectedDateChanged"/>

        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="{DynamicResource Btn_Abandon}" Width="90" Margin="0,0,10,0" Click="BtnCancel_Click"/>
            <Button x:Name="BtnConfirm" Content="{DynamicResource Btn_Confirm}"
                    Width="90" IsEnabled="False" Click="BtnConfirm_Click"/>
        </StackPanel>
    </Grid>
</Window>
