<Window x:Class="WpfClient.AddAuthorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AddAuthor_Title}"
        Height="650" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Content="{DynamicResource AddAuthor_Lbl_IdCard}" FontWeight="SemiBold"/>
            <TextBox Grid.Row="1" x:Name="TxtIdCard" Margin="0,0,0,10" Height="25"/>

            <Label Grid.Row="2" Content="{DynamicResource AddAuthor_Lbl_Name}" FontWeight="SemiBold"/>
            <TextBox Grid.Row="3" x:Name="TxtName" Margin="0,0,0,10" Height="25"/>

            <Label Grid.Row="4" Content="{DynamicResource AddAuthor_Lbl_LastName}" FontWeight="SemiBold"/>
            <TextBox Grid.Row="5" x:Name="TxtLastName" Margin="0,0,0,10" Height="25"/>

            <Label Grid.Row="6" Content="{DynamicResource AddAuthor_Lbl_DateOfBirth}" FontWeight="SemiBold"/>
            <DatePicker Grid.Row="7" x:Name="DpDateOfBirth" Margin="0,0,0,15" Height="25"/>

            <Label Grid.Row="8" Content="{DynamicResource AddAuthor_Lbl_Phone}" FontWeight="SemiBold"/>
            <TextBox Grid.Row="9" x:Name="TxtPhoneNumber" Margin="0,0,0,10" Height="25"/>

            <Label Grid.Row="10" Content="{DynamicResource AddAuthor_Lbl_Email}" FontWeight="SemiBold"/>
            <TextBox Grid.Row="11" x:Name="TxtEmail" Margin="0,0,0,10" Height="25"/>

            <Label Grid.Row="12" Content="{DynamicResource AddAuthor_Lbl_Experience}" FontWeight="SemiBold"/>
            <TextBox Grid.Row="13" x:Name="TxtExperienceLength" Margin="0,0,0,15" Height="25"/>

            <GroupBox Grid.Row="14" Header="{DynamicResource AddAuthor_Gb_Address}" FontWeight="SemiBold" Margin="0,0,0,15">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Content="{DynamicResource AddAuthor_Lbl_Street}"/>
                    <TextBox Grid.Row="1" x:Name="TxtStreet" Margin="0,0,0,5" Height="25"/>
                    <Label Grid.Row="2" Content="{DynamicResource AddAuthor_Lbl_Number}"/>
                    <TextBox Grid.Row="3" x:Name="TxtNumber" Margin="0,0,0,5" Height="25"/>
                    <Label Grid.Row="4" Content="{DynamicResource AddAuthor_Lbl_City}"/>
                    <TextBox Grid.Row="5" x:Name="TxtCity" Margin="0,0,0,5" Height="25"/>
                    <Label Grid.Row="6" Content="{DynamicResource AddAuthor_Lbl_State}"/>
                    <TextBox Grid.Row="7" x:Name="TxtState" Margin="0,0,0,5" Height="25"/>
                    <Label Grid.Row="8" Content="{DynamicResource AddAuthor_Lbl_Country}"/>
                    <TextBox Grid.Row="9" x:Name="TxtCountry" Text="Srbija" Margin="0,0,0,5" Height="25"/>
                </Grid>
            </GroupBox>

            <StackPanel Grid.Row="15" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="BtnOk" Content="{DynamicResource Btn_Save}" Width="100" Height="30" Margin="0,0,10,0"
                        Click="BtnOk_Click" FontWeight="SemiBold"/>
                <Button x:Name="BtnCancel" Content="{DynamicResource Btn_Cancel}" Width="100" Height="30"
                        Click="BtnCancel_Click" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
