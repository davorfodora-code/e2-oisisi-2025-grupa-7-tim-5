<Window x:Class="WpfClient.PublisherEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Izmena izdavača"
        Height="550"
        Width="600"
        WindowStartupLocation="CenterOwner"
        Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Izdavač" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="Informacije" 
                           FontSize="18" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,15"/>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Naziv:" VerticalAlignment="Center" FontSize="16" Margin="0,0,0,5"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtName" Padding="5" Margin="0,0,0,9.8" Width="350"/>
                </Grid>

                <TextBlock Text="Autori" 
                           FontSize="18" 
                           FontWeight="SemiBold" 
                           Margin="0,15,0,10"/>

                <ListBox x:Name="LstAuthors" 
                         SelectionMode="Multiple"
                         BorderBrush="#CCCCCC" 
                         BorderThickness="1"
                         Height="250"
                         Loaded="LstAuthors_Loaded">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding FullName}" 
                                      IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                      Margin="2"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Left" 
                    Margin="0,20,0,0">
            <Button x:Name="BtnOk" 
                    Content="Sačuvaj" 
                    Width="100" 
                    Height="35" 
                    Margin="0,0,10,0"
                    Click="BtnOk_Click"/>
            <Button x:Name="BtnCancel" 
                    Content="Otkaži" 
                    Width="100" 
                    Height="35"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>