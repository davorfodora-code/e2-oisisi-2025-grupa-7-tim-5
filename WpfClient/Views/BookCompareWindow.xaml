<Window x:Class="WpfClient.BookCompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Poređenje knjiga - Posetioci"
        Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="White">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <TextBlock Grid.Row="0"
                   Text="Poređenje knjiga"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Prva knjiga:" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbBook1"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Isbn"
                          Height="28"/>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="Druga knjiga:" Margin="0,0,0,4"/>
                <ComboBox x:Name="CmbBook2"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Isbn"
                          Height="28"/>
            </StackPanel>

            <Button Grid.Column="3"
                    x:Name="BtnCompare"
                    Content="Prikaži rezultate"
                    Height="28"
                    Width="130"
                    Margin="15,18,0,0"
                    Click="BtnCompare_Click"/>
        </Grid>

        <Border Grid.Row="2"
                Background="#F5F5F5"
                Padding="8"
                CornerRadius="4"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Pretraga:"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <TextBox Grid.Column="1"
                         x:Name="TxtSearch"
                         Height="28"
                         Padding="6"
                         KeyDown="TxtSearch_KeyDown"
                         TextChanged="TxtSearch_TextChanged"/>

                <Button Grid.Column="2"
                        x:Name="BtnSearch"
                        Content="Traži"
                        Width="60"
                        Height="28"
                        Margin="5,0,0,0"
                        Click="BtnSearch_Click"/>
            </Grid>
        </Border>

        <TabControl Grid.Row="3" x:Name="ResultTabs">

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Obe knjige na listi želja"/>
                        <TextBlock x:Name="TxtCount1" Text=" (0)" FontWeight="Bold"/>
                    </StackPanel>
                </TabItem.Header>
                <DataGrid x:Name="GridBothWishlist"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          BorderBrush="#E0E0E0"
                          BorderThickness="1"
                          RowBackground="White"
                          AlternatingRowBackground="#F8F9FA"
                          FontSize="14"
                          RowHeight="30"
                          HeadersVisibility="Column"
                          VerticalGridLinesBrush="#E0E0E0"
                          HorizontalGridLinesBrush="#E0E0E0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Broj članske karte" Binding="{Binding MembershipNumber}" Width="150"/>
                        <DataGridTextColumn Header="Ime" Binding="{Binding Name}" Width="120"/>
                        <DataGridTextColumn Header="Prezime" Binding="{Binding LastName}" Width="130"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding DisplayStatus}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Kupili prvu, nisu kupili drugu"/>
                        <TextBlock x:Name="TxtCount2" Text=" (0)" FontWeight="Bold"/>
                    </StackPanel>
                </TabItem.Header>
                <DataGrid x:Name="GridBoughtFirst"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          BorderBrush="#E0E0E0"
                          BorderThickness="1"
                          RowBackground="White"
                          AlternatingRowBackground="#F8F9FA"
                          FontSize="14"
                          RowHeight="30"
                          HeadersVisibility="Column"
                          VerticalGridLinesBrush="#E0E0E0"
                          HorizontalGridLinesBrush="#E0E0E0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Broj članske karte" Binding="{Binding MembershipNumber}" Width="150"/>
                        <DataGridTextColumn Header="Ime" Binding="{Binding Name}" Width="120"/>
                        <DataGridTextColumn Header="Prezime" Binding="{Binding LastName}" Width="130"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding DisplayStatus}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

        </TabControl>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button x:Name="BtnClose"
                    Content="Zatvori"
                    Width="100"
                    Height="35"
                    Click="BtnClose_Click"/>
        </StackPanel>
    </Grid>
</Window>
