<Window x:Class="WpfClient.VisitorAuthorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Posetioci sa knjigama autora u listi želja"
        Height="600"
        Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Informacije o izabranom autoru -->
        <Border Grid.Row="0" 
                Background="#2196F3" 
                Padding="15" 
                CornerRadius="5" 
                Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="Izabrani autor:" 
                           FontWeight="Bold" 
                           Foreground="White" 
                           FontSize="16" 
                           VerticalAlignment="Center" 
                           Margin="0,0,10,0"/>

                <TextBlock Grid.Column="1" 
                           x:Name="TxtAuthorInfo" 
                           Foreground="White" 
                           FontSize="16" 
                           VerticalAlignment="Center"
                           Text=""/>
            </Grid>
        </Border>

        <!-- Search box -->
        <Border Grid.Row="1" 
                Background="White" 
                Padding="10" 
                CornerRadius="5" 
                Margin="0,0,0,15"
                BorderBrush="#E0E0E0" 
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="Pretraga: " 
                           FontWeight="SemiBold" 
                           VerticalAlignment="Center" 
                           Margin="0,0,10,0"/>

                <TextBox Grid.Column="1" 
                         x:Name="TxtSearch" 
                         Padding="8" 
                         KeyDown="TxtSearch_KeyDown"
                         TextChanged="TxtSearch_TextChanged"/>

                <Button Grid.Column="2" 
                        x:Name="BtnSearch" 
                        Content="Pretraži" 
                        Width="100" 
                        Margin="10,0,0,0" 
                        Padding="8" 
                        Click="BtnSearch_Click"/>
            </Grid>
        </Border>

        <!-- DataGrid sa posetiocima -->
        <DataGrid Grid.Row="2" 
                  x:Name="VisitorsGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  RowHeight="35"
                  BorderBrush="#E0E0E0"
                  BorderThickness="1"
                  Margin="0,0,0,15">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Broj članske karte" Binding="{Binding MembershipNumber}" Width="150"/>
                <DataGridTextColumn Header="Ime" Binding="{Binding Name}" Width="150"/>
                <DataGridTextColumn Header="Prezime" Binding="{Binding LastName}" Width="150"/>
                <DataGridTextColumn Header="Status" Binding="{Binding DisplayStatus}" Width="100"/>
                <DataGridTextColumn Header="Adresa" Binding="{Binding DisplayAddress}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status bar i dugmad -->
        <Border Grid.Row="3" 
                Background="#F0F0F0" 
                Padding="10" 
                CornerRadius="5"
                BorderBrush="#E0E0E0" 
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           x:Name="TxtStatus" 
                           Text="Ukupno posetilaca: 0" 
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnClose" 
                            Content="Zatvori" 
                            Width="100" 
                            Height="35" 
                            Click="BtnClose_Click"
                            IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>