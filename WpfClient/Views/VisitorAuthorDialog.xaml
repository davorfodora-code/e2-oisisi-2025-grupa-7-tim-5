<Window x:Class="WpfClient.VisitorAuthorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource VisitorsByAuthor_Title}"
        Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#F5F5F5">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2196F3" Padding="15" CornerRadius="5" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{DynamicResource VisitorsByAuthor_SelectedAuthor}"
                           FontWeight="Bold" Foreground="White" FontSize="16"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Grid.Column="1" x:Name="TxtAuthorInfo" Foreground="White"
                           FontSize="16" VerticalAlignment="Center" Text=""/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" Padding="10" CornerRadius="5" Margin="0,0,0,15"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{DynamicResource VisitorsByAuthor_Lbl_Search}"
                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" x:Name="TxtSearch" Padding="8"
                         KeyDown="TxtSearch_KeyDown" TextChanged="TxtSearch_TextChanged"/>
                <Button Grid.Column="2" x:Name="BtnSearch" Content="{DynamicResource Btn_Search}"
                        Width="100" Margin="10,0,0,0" Padding="8" Click="BtnSearch_Click"/>
            </Grid>
        </Border>

        <DataGrid Grid.Row="2" x:Name="VisitorsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" RowHeight="35" BorderBrush="#E0E0E0" BorderThickness="1"
                  Margin="0,0,0,15">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding MembershipNumber}" Width="150">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource Col_MembershipNumber}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding Name}" Width="150">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource Col_FirstName}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding LastName}" Width="150">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource Col_LastName}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding DisplayStatus}" Width="100">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource Col_Status}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
                <DataGridTextColumn Binding="{Binding DisplayAddress}" Width="*">
                    <DataGridTextColumn.Header>
                        <TextBlock Text="{DynamicResource Col_Address}"/>
                    </DataGridTextColumn.Header>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Background="#F0F0F0" Padding="10" CornerRadius="5"
                BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="TxtStatus"
                           Text="{DynamicResource VisitorsByAuthor_TotalVisitors}"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnClose" Content="{DynamicResource Btn_Close}"
                            Width="100" Height="35" Click="BtnClose_Click" IsDefault="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
